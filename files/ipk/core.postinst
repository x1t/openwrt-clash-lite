#!/bin/sh
[ -n "$IPKG_INSTROOT" ] && exit 0
CFG=/etc/config/openwrt-clash-lite
if [ ! -f $CFG ]; then
	touch $CFG
	uci set openwrt-clash-lite.main=main
	uci set openwrt-clash-lite.main.port='19097'
	uci set openwrt-clash-lite.main.log_level='warning'
fi
if [ -z "$(uci -q get openwrt-clash-lite.main.secret)" ]; then
	uci set openwrt-clash-lite.main.secret="$(head -c 16 /dev/urandom | md5sum | cut -c1-32)"
fi
uci commit openwrt-clash-lite
chmod 600 $CFG
/usr/bin/openwrt-clash-lite sync-cron >/dev/null 2>&1
# newer rpcd loads the new ubus plugin on reload; older ones (24.10) keep the old code (or none)
# until a restart, which also logs out LuCI sessions, so only restart when the reload was not enough
want=$(/usr/bin/openwrt-clash-lite version | cut -d' ' -f2)
plugin_ok() { [ "$(ubus call oclite version 2>/dev/null | jsonfilter -e '@.plugin')" = "$want" ]; }
/etc/init.d/rpcd reload
sleep 1
if ! plugin_ok; then
	/etc/init.d/rpcd restart
	# rpcd needs a few seconds after a restart before `oclite` answers
	i=0
	while ! plugin_ok && [ $i -lt 10 ]; do sleep 1; i=$((i + 1)); done
fi
# a fresh install never starts by itself (it would fight OpenClash); an upgrade restores the state
if [ -f /tmp/openwrt-clash-lite.restart ]; then
	rm -f /tmp/openwrt-clash-lite.restart
	/etc/init.d/openwrt-clash-lite start
fi
exit 0
