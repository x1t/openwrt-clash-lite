#!/bin/sh
[ -n "$IPKG_INSTROOT" ] && exit 0
/etc/init.d/openwrt-clash-lite disable >/dev/null 2>&1
/etc/init.d/openwrt-clash-lite stop >/dev/null 2>&1
# procd stops asynchronously; wait until mihomo has removed its routes and firewall rules
i=0
while pidof openwrt-clash-lite >/dev/null && [ $i -lt 20 ]; do sleep 1; i=$((i + 1)); done
exit 0
