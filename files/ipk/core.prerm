#!/bin/sh
[ -n "$IPKG_INSTROOT" ] && exit 0
SVC=/etc/init.d/openwrt-clash-lite
# opkg sets PKG_UPGRADE=1 when this runs as part of an upgrade: keep the boot setting and
# remember whether the service ran, so postinst of the new version can start it again
if [ "$PKG_UPGRADE" = "1" ]; then
	pidof openwrt-clash-lite >/dev/null && touch /tmp/openwrt-clash-lite.restart
else
	$SVC disable >/dev/null 2>&1
	# remove our daily update job; other crontab lines stay
	if grep -q '# openwrt-clash-lite$' /etc/crontabs/root 2>/dev/null; then
		sed -i '/# openwrt-clash-lite$/d' /etc/crontabs/root
		/etc/init.d/cron restart
	fi
fi
$SVC stop >/dev/null 2>&1
# procd stops asynchronously; wait until mihomo has removed its routes and firewall rules
i=0
while pidof openwrt-clash-lite >/dev/null && [ $i -lt 20 ]; do sleep 1; i=$((i + 1)); done
exit 0
