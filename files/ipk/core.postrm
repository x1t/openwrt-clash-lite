#!/bin/sh
[ -n "$IPKG_INSTROOT" ] && exit 0
# an upgrade keeps the downloaded subscriptions, core and rule caches
[ "$PKG_UPGRADE" = "1" ] && exit 0
rm -rf /etc/openwrt-clash-lite /tmp/openwrt-clash-lite /usr/share/openwrt-clash-lite
/etc/init.d/rpcd reload
sleep 1
ubus list oclite >/dev/null 2>&1 && /etc/init.d/rpcd restart
exit 0
